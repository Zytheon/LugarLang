<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="LugarLang.Mobile.Controls.Developer.DeveloperOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HorizontalOptions="Fill"
    VerticalOptions="Fill"
    IsVisible="False">

    <Grid>

    <AbsoluteLayout
    x:Name="CandidateSurface"
    ZIndex="20"
    IsVisible="False"
    InputTransparent="True" />

        <Border
    x:Name="MultiSelectToolbar"
    ZIndex="95"
    IsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}"
    Stroke="Black"
    StrokeThickness="2"
    Padding="10"
    HorizontalOptions="Center"
    VerticalOptions="Start"
    Margin="0,16,0,0">

            <Grid
        ColumnDefinitions="Auto,Auto"
        ColumnSpacing="8">

                <Button
            Text="Cancel"
            Clicked="OnMultiSelectCancelClicked" />

                <Button
            x:Name="MultiSelectGroupButton"
            Grid.Column="1"
            Text="Group Selected (0)"
            Clicked="OnMultiSelectGroupClicked" />

            </Grid>

        </Border>

        <Border
    x:Name="OverlapChooser"
    ZIndex="100"
    IsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}"
    Stroke="Black"
    StrokeThickness="2"
    InputTransparent="False"
    Padding="16"
    WidthRequest="320"
    HorizontalOptions="Center"
    VerticalOptions="Center">
            
            

            <VerticalStackLayout
        Spacing="10">

                <Border
            x:Name="OverlapChooserDragHandle"
            InputTransparent="False"        
            Padding="4">

                    <Border.GestureRecognizers>
                        <PanGestureRecognizer
                    PanUpdated="OnOverlapChooserPanUpdated" />
                    </Border.GestureRecognizers>

                    <Label
                Text="Select UI Element"
                FontSize="20"
                FontAttributes="Bold" />

                </Border>

                <Label
            Text="Multiple UI elements overlap here. Choose which one you want to edit."
            FontSize="13" />

                <VerticalStackLayout
            x:Name="OverlapOptionsLayout"
            Spacing="6" />

                <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="8"
            Margin="0,8,0,0">

                    <Button
                Text="Cancel"
                Clicked="OnOverlapCancelClicked" />

                    <Button
                x:Name="OverlapConfirmButton"
                Grid.Column="1"
                Text="Confirm"
                IsEnabled="False"
                Clicked="OnOverlapConfirmClicked" />

                </Grid>

            </VerticalStackLayout>

        </Border>
        <!-- Visual editor surface -->
        <AbsoluteLayout
    x:Name="EditorSurface"
    ZIndex="10"
    IsVisible="False"
    InputTransparent="True"
    CascadeInputTransparent="False">

            <AbsoluteLayout.GestureRecognizers>
                <TapGestureRecognizer
            Tapped="OnEditorSurfaceTapped" />
            </AbsoluteLayout.GestureRecognizers>

            <Border
    x:Name="SelectionSurface"
    BackgroundColor="Transparent"
    Stroke="Red"
    StrokeThickness="3"
    InputTransparent="False">

                <Border.GestureRecognizers>
                    <PanGestureRecognizer
            PanUpdated="OnSelectionPanUpdated" />
                </Border.GestureRecognizers>

            </Border>

        </AbsoluteLayout>

        <Border
    x:Name="GroupPanel"
    ZIndex="95"
    IsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}"
    Stroke="Black"
    StrokeThickness="2"
    Padding="16"
    WidthRequest="320"
    HorizontalOptions="Center"
    VerticalOptions="Center">

            <VerticalStackLayout
        Spacing="10">

                <Label
            Text="Group Selected Elements"
            FontSize="18"
            FontAttributes="Bold" />

                <Label
            Text="Group Name"
            FontAttributes="Bold" />

                <Entry
            x:Name="GroupNameEntry"
            Placeholder="Enter a name for this group" />

                <BoxView
            HeightRequest="1" />

                <VerticalStackLayout
            x:Name="GroupMembersLayout"
            Spacing="4" />

                <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="8"
            Margin="0,8,0,0">

                    <Button
                Text="Cancel"
                Clicked="OnGroupCancelClicked" />

                    <Button
                Grid.Column="1"
                Text="Group"
                Clicked="OnGroupConfirmClicked" />

                </Grid>

            </VerticalStackLayout>

        </Border>

        <!-- Inspector -->
        <Border
    x:Name="InspectorPanel"
    ZIndex="90"
    IsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}"
    Stroke="Black"
    StrokeThickness="2"
    InputTransparent="False"
    Padding="14"
    WidthRequest="320"
    HorizontalOptions="End"
    VerticalOptions="Start"
    Margin="16">

            <ScrollView>

                <VerticalStackLayout
            Spacing="10">

                    <Border
                x:Name="InspectorDragHandle"
                InputTransparent="False"        
                Padding="4">

                        <Border.GestureRecognizers>
                            <PanGestureRecognizer
                        PanUpdated="OnInspectorPanUpdated" />
                        </Border.GestureRecognizers>

                        <Grid
                    ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                        Spacing="2">

                                <Label
                            Text="UI Inspector"
                            FontSize="20"
                            FontAttributes="Bold" />

                                <Label
                            Text="Drag here to move panel"
                            FontSize="11" />

                            </VerticalStackLayout>

                            <Button
                        Grid.Column="1"
                        Text="✕"
                        WidthRequest="40"
                        HeightRequest="40"
                        Clicked="OnCloseInspectorClicked" />

                        </Grid>

                    </Border>

                    <Label
    x:Name="InspectorTypeLabel" />

                    <Label
    x:Name="InspectorNameLabel" />

                    <Label
    x:Name="InspectorTextLabel" />

                    <Label
    x:Name="InspectorPositionLabel" />

                    <Label
    x:Name="InspectorGroupLabel"
    IsVisible="False" />

                    <Button
    x:Name="UngroupButton"
    Text="Ungroup"
    IsVisible="False"
    Clicked="OnUngroupClicked" />

                    <BoxView
    HeightRequest="1" />

                    <Label
    Text="Size"
    FontAttributes="Bold" />

                    <Grid
    ColumnDefinitions="Auto,*"
    RowDefinitions="Auto,Auto"
    ColumnSpacing="8"
    RowSpacing="6">

                        <Label
        Text="Width"
        VerticalOptions="Center" />

                        <Entry
        x:Name="WidthEntry"
        Grid.Column="1"
        Keyboard="Numeric"
        Focused="OnSizeEntryFocused"
        Unfocused="OnSizeEntryCompleted" />

                        <Label
        Grid.Row="1"
        Text="Height"
        VerticalOptions="Center" />

                        <Entry
        x:Name="HeightEntry"
        Grid.Row="1"
        Grid.Column="1"
        Keyboard="Numeric"
        Focused="OnSizeEntryFocused"
        Unfocused="OnSizeEntryCompleted" />

                    </Grid>

                    <Label
                Text="History"
                FontAttributes="Bold" />

                    <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">

                        <Button
                    x:Name="UndoButton"
                    Text="↶ Undo"
                    Clicked="OnUndoClicked" />

                        <Button
                    x:Name="RedoButton"
                    Grid.Column="1"
                    Text="↷ Redo"
                    Clicked="OnRedoClicked" />

                    </Grid>

                    <BoxView
                HeightRequest="1" />

                    <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">

                        <Button
                    Text="Cancel"
                    Clicked="OnCancelEditClicked" />

                        <Button
                    Grid.Column="1"
                    Text="Done"
                    Clicked="OnSaveEditClicked" />

                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>

</ContentView>