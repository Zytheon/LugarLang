<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LugarLang.Mobile.Pages.DeveloperPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Developer">

    <VerticalStackLayout
        Padding="20"
        Spacing="16">

        <Label
            Text="Developer Tools"
            FontSize="30"
            FontAttributes="Bold" />

        <Label
            Text="Manage the content and configuration used by LugarLang."
            FontSize="16" />

        <Button
            Text="Manage Categories"
            HeightRequest="55"
            Clicked="OnManageCategoriesClicked" />

    </VerticalStackLayout>

</ContentPage>