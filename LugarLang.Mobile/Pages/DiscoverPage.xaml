<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LugarLang.Mobile.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:developer="clr-namespace:LugarLang.Mobile.Controls.Developer"
    Title="Discover">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Padding="20"
                Spacing="24">

                <Label
                    Text="Discover"
                    FontSize="32"
                    FontAttributes="Bold" />



                <!-- Featuring -->

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="Featuring"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Button
                        x:Name="FeaturedRegionButton"
                        Text="Northern Mindanao"
                        FontSize="18"
                        HeightRequest="100"
                        Clicked="OnFeaturedRegionClicked" />

                </VerticalStackLayout>

                <!-- Near Me -->

                <Button
                    Text="📍  Near Me"
                    FontSize="18"
                    HeightRequest="60"
                    Clicked="OnNearMeClicked" />

                <Button
                    Text="🔄 Refresh"
                    FontSize="16"
                    HeightRequest="50"
                    IsVisible="True"
                    Clicked="OnRefreshClicked" />

                <Button
                    Text="🔧 Developer Editor Test"
                    Clicked="OnDeveloperEditorTestClicked" />

                <VerticalStackLayout
                    x:Name="DiscoveryCategoriesLayout"
                    Spacing="24" />

            </VerticalStackLayout>

        </ScrollView>

        <developer:DeveloperLauncher
            x:Name="DeveloperLauncherControl"
            Margin="0,0,16,16" />

    </Grid>

</ContentPage>