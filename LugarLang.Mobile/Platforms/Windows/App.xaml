<maui:MauiWinUIApplication
    x:Class="LugarLang.Mobile.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:LugarLang.Mobile.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <SolidColorBrush
           x:Key="SystemControlPageBackgroundMediumAltMediumBrush"
           Color="{StaticResource SystemAltMediumColor}" />
        <Color
           x:Key="SystemAltMediumColor">#00000000</Color>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>