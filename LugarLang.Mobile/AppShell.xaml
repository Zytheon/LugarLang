<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="LugarLang.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LugarLang.Mobile.Pages"
    Title="LugarLang">

    <TabBar>

        <ShellContent
    Title="Discover"
    ContentTemplate="{DataTemplate pages:DiscoverPage}"
    Route="DiscoverPage" />

        <ShellContent
            Title="Map"
            ContentTemplate="{DataTemplate pages:MapPage}"
            Route="MapPage" />

        <ShellContent
            Title="Book"
            ContentTemplate="{DataTemplate pages:BookPage}"
            Route="BookPage" />
        
        <ShellContent
            Title="Developer"
            ContentTemplate="{DataTemplate pages:DeveloperPage}"
            Route="DeveloperPage" />
        
    </TabBar>

</Shell>


